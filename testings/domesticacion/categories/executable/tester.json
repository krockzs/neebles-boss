            "required_argument": "absent",
            "forbidden_argument": "absent"
          },
          "expect": "invalid"
        },
        {
          "id": "required-present-forbidden-present",
          "select": {
            "required_argument": "present",
            "forbidden_argument": "present"
          },
          "expect": "invalid"
