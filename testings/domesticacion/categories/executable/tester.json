        {
          "id": "result-can-fallback",
          "select": {
            "caller_return": "result",
            "error_policy": "fallback"
          },
          "expect": "valid"
        },
        {
          "id": "plain-value-requires-fallback",
          "select": {
            "caller_return": "plain_value",
            "error_policy": "fallback"
          },
          "expect": "valid"
        },
        {
          "id": "plain-value-can-ignore",
          "select": {
            "caller_return": "plain_value",
            "error_policy": "ignore"
          },
          "expect": "valid"
        },
        {
          "id": "plain-value-cannot-propagate",
          "select": {
            "caller_return": "plain_value",
            "error_policy": "propagate"
          },
          "expect": "invalid"
        }
      ]
    },
    {
      "name": "boss.argument_contract",
      "options": {
        "required_argument": [
          "present",
          "absent"
        ],
        "forbidden_argument": [
          "absent",
          "present"
        ]
      },
      "cases": [
        {
          "id": "required-present-forbidden-absent",
