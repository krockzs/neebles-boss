          "single",
          "multiple"
        ],
        "path_form": [
          "relative",
          "absolute",
          "parent_escape"
        ]
      },
      "cases": [
        {
          "id": "relative-single-file",
          "select": {
            "target_shape": "file",
            "target_count": "single",
            "path_form": "relative"
          },
          "expect": "pass"
        },
        {
          "id": "relative-single-directory",
          "select": {
            "target_shape": "directory",
            "target_count": "single",
            "path_form": "relative"
          },
          "expect": "pass"
        },
        {
          "id": "relative-single-symlink",
          "select": {
            "target_shape": "symlink",
            "target_count": "single",
            "path_form": "relative"
          },
          "expect": "pass"
        },
        {
          "id": "relative-multiple-mixed",
          "select": {
            "target_shape": "mixed",
            "target_count": "multiple",
            "path_form": "relative"
          },
          "expect": "pass"
        },
        {
          "id": "relative-single-missing",
          "select": {
            "target_shape": "missing",
            "target_count": "single",
            "path_form": "relative"
          },
          "expect": "report_missing"
        },
        {
          "id": "absolute-target",
          "select": {
            "target_shape": "file",
            "target_count": "single",
            "path_form": "absolute"
          },
          "expect": "error"
        },
        {
          "id": "parent-escape-target",
          "select": {
            "target_shape": "file",
            "target_count": "single",
            "path_form": "parent_escape"
          },
          "expect": "error"
        }
      ]
    },
    {
      "name": "boss.path_contract",
      "options": {
        "path_form": [
          "relative",
          "absolute",
          "parent_escape"
        ],
        "cardinality": [
          "single",
          "multiple"
        ],
        "presence": [
          "present",
          "missing"
        ]
      },
      "cases": [
        {
          "id": "relative-single-present",
          "select": {
            "path_form": "relative",
            "cardinality": "single",
            "presence": "present"
          },
          "expect": "pass"
        },
        {
          "id": "relative-multiple-present",
          "select": {
            "path_form": "relative",
            "cardinality": "multiple",
            "presence": "present"
          },
          "expect": "pass"
        },
        {
          "id": "relative-missing",
          "select": {
            "path_form": "relative",
            "cardinality": "single",
            "presence": "missing"
          },
          "expect": "report_missing"
        },
        {
          "id": "absolute-rejected",
          "select": {
            "path_form": "absolute",
            "cardinality": "single",
            "presence": "present"
          },
          "expect": "error"
        },
        {
          "id": "parent-escape-rejected",
          "select": {
            "path_form": "parent_escape",
            "cardinality": "single",
            "presence": "present"
          },
          "expect": "error"
        }
      ]
    },
    {
      "name": "boss.transport_reference",
      "options": {
        "source_form": [
          "absolute",
          "relative"
        ],
        "semantic_target": [
          "inside_present",
          "inside_missing",
          "outside"
        ],
        "transported_form": [
          "relative",
          "absolute"
        ]
      },
      "cases": [
        {
          "id": "absolute-present-rebases-relative",
          "select": {
            "source_form": "absolute",
            "semantic_target": "inside_present",
            "transported_form": "relative"
          },
          "expect": "pass"
        },
        {
          "id": "absolute-missing-rebases-relative",
          "select": {
            "source_form": "absolute",
            "semantic_target": "inside_missing",
            "transported_form": "relative"
          },
          "expect": "pass"
        },
        {
          "id": "absolute-present-must-not-survive",
          "select": {
            "source_form": "absolute",
            "semantic_target": "inside_present",
            "transported_form": "absolute"
          },
          "expect": "error"
        },
        {
          "id": "absolute-missing-must-not-capture-host",
          "select": {
            "source_form": "absolute",
            "semantic_target": "inside_missing",
            "transported_form": "absolute"
          },
          "expect": "error"
        },
        {
          "id": "relative-present-remains-relative",
          "select": {
            "source_form": "relative",
            "semantic_target": "inside_present",
            "transported_form": "relative"
          },
          "expect": "pass"
        },
        {
          "id": "relative-missing-remains-relative",
          "select": {
            "source_form": "relative",
            "semantic_target": "inside_missing",
            "transported_form": "relative"
          },
          "expect": "pass"
        },
        {
          "id": "relative-outside-is-rejected",
          "select": {
            "source_form": "relative",
            "semantic_target": "outside",
            "transported_form": "relative"
          },
          "expect": "error"
        },
        {
          "id": "relative-must-not-become-absolute",
          "select": {
            "source_form": "relative",
            "semantic_target": "inside_present",
            "transported_form": "absolute"
          },
          "expect": "error"
        }
      ]
    }
  ]
