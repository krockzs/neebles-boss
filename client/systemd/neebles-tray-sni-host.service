[Unit]
Description=N.E.E.B.L.E.S. Tray StatusNotifier Host
After=graphical-session-pre.target neebles-tray-manager.service
Requires=neebles-tray-manager.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/opt/neebles/client/backend/neebles-backend tray host
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
