[Unit]
Description=N.E.E.B.L.E.S. Boss Runtime
Requires=neebles-stage0.service
After=neebles-stage0.service

[Service]
Type=simple
EnvironmentFile=/etc/neebles/runtime.env
ExecStart=/opt/neebles/client/backend/neebles-backend socket serve
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
