[Unit]
Description=N.E.E.B.L.E.S. Tray Manager
After=graphical-session-pre.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStartPre=/opt/neebles/client/backend/neebles-backend stage0 wait
ExecStart=/opt/neebles/client/backend/neebles-backend tray serve
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
