#!/bin/bash
set -euo pipefail

VERSION="0.0.1"
BASE_URL="https://github.com/krockzs/neebles-boss/releases/download/v${VERSION}"
TMP_DIR="$(mktemp -d /tmp/neebles-bootstrap.XXXXXX)"

cleanup() {
    rm -rf "$TMP_DIR"
}
trap cleanup EXIT

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "[N.E.E.B.L.E.S.] Required command not found: $1" >&2
        exit 1
    }
}

require_command curl

printf '%s\n' "[N.E.E.B.L.E.S.] Preparing Boss ${VERSION} installer..."

for asset in neebles-installer neebles-backend neebles-ui install.sh; do
    printf '%s\n' "[N.E.E.B.L.E.S.] Downloading ${asset}..."
    curl --fail --location --silent --show-error \
        "${BASE_URL}/${asset}" \
        --output "${TMP_DIR}/${asset}"
done

chmod +x \
    "${TMP_DIR}/neebles-installer" \
    "${TMP_DIR}/neebles-backend" \
    "${TMP_DIR}/neebles-ui" \
    "${TMP_DIR}/install.sh"

printf '%s\n' "[N.E.E.B.L.E.S.] Launching graphical installer..."

"${TMP_DIR}/neebles-installer" \
    "${TMP_DIR}/install.sh" \
    "${TMP_DIR}/neebles-backend" \
    "${TMP_DIR}/neebles-ui"
