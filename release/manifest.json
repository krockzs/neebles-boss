    "command": "/usr/local/bin/neebles",
    "modules_root": "/opt/neebles/modules",
    "shared_root": "/opt/neebles/shared"
  },
  "registry_manifests": {
    "checking": "https://raw.githubusercontent.com/krockzs/neebles-registry/main/boss/checking.json",
